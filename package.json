{
  "name": "unlimited-study",
  "version": "1.0.0",
  "private": true,
  "description": "Unlimited Study (دراسة بلا حدود) - university study platform on Node.js + PostgreSQL + Google Cloud Storage. تم تحت إنتاج Unlimited Team",
  "type": "commonjs",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --watch scripts/start.js",
    "build": "node scripts/build-client.js",
    "start": "node scripts/start.js",
    "seed": "node scripts/seed.js",
    "extract": "python3 scripts/extract-roster.py",
    "test": "vitest run",
    "screenshots": "node scripts/screenshots.js",
    "db:up": "docker compose up -d db"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@google-cloud/storage": "^9.0.0",
    "argon2": "^0.45.2",
    "chart.js": "^4.6.1",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "google-auth-library": "^11.3.3",
    "gsap": "^3.15.1",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "axe-core": "^4.14.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "playwright-core": "^1.64.1",
    "supertest": "^7.3.1",
    "tailwindcss": "^3.4.19",
    "vitest": "^5.1.0"
  }
}