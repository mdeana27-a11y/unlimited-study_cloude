# Copy to .env (never commit it). On Google Cloud these come from Secret Manager / Cloud Run env, see docs/DEPLOY-GOOGLE.md.

NODE_ENV=production
PORT=3000

# ── Required ──
# 32+ random chars:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# PostgreSQL. Local:        postgres://study:password@localhost:5432/unlimited_study
#             Cloud SQL:    postgres://USER:PASS@/DB?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=postgres://study:change-me@localhost:5432/unlimited_study
# Needed on the FIRST start only (creates the supervisor account). 10+ chars.
ADMIN_PASSWORD=
ADMIN_EMAIL=mostafa@example.com
ADMIN_DISPLAY_NAME=مصطفى المشرف التنفيذي

# ── File storage ──
# GCS_BUCKET set  -> Google Cloud Storage (uses Application Default Credentials; required on Cloud Run).
# GCS_BUCKET empty -> local disk at STORAGE_DIR/uploads (needs a persistent disk/volume).
GCS_BUCKET=
STORAGE_DIR=./storage
MAX_UPLOAD_MB=            # default 100 (30 on Cloud Run: its request limit is 32 MiB)

# ── Optional ──
GOOGLE_CLIENT_ID=
ADMIN_TOTP_SECRET=        # base32; enables 2FA for the supervisor
COOKIE_SECURE=            # default true in production; set false ONLY for plain http://localhost
TRUST_PROXY=              # auto 1 on Cloud Run/Render/Railway/Fly; set 1 behind nginx/Caddy
DB_POOL_MAX=              # default 10 (use 5 on Cloud Run: instances x pool must stay below Cloud SQL max_connections)
DB_SSL=                   # true for a public-IP database that requires SSL (unix-socket Cloud SQL does not)
LOG_RETENTION_MONTHS=12
COHORT_LABEL=الفرقة الأولى — برنامج علوم البيانات
